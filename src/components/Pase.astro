---
// Pase.astro
// Muestra el número de pases asignados al invitado.
// El número se envía desde index.astro como parámetro: <Pase numeroPases={2} />

interface Props {
    numeroPases?: number; // 1, 2, 3, etc.
}

const { numeroPases = 1 } = Astro.props;

const esSingular = numeroPases === 1;
const etiquetaPase = esSingular ? "Pase" : "Pases";
const titulo = esSingular ? "Pase Reservado" : "Pases Reservados";
const mensaje = esSingular
    ? "Esperamos contar con tu presencia"
    : "Esperamos contar con su presencia";
---

<section class="py-6 px-4 relative overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
        <!-- 🌸 SEPARADOR SUPERIOR -->
        <div class="flex justify-center mb-4" id="separador-pases">
            <img
                src="/imagenes/FlorSeparador.webp"
                alt="Separador decorativo"
                class="w-48 md:w-56 lg:w-64 h-auto object-contain opacity-90"
            />
        </div>

        <!-- CARD (mismo estilo que el resto de los cards) -->
        <div
            class="relative z-10 max-w-2xl mx-auto bg-white rounded-3xl shadow-lg border-2 border-[#a27735] px-6 py-6 md:px-10 md:py-8 text-center"
            id="card-pases"
        >
            <!-- ÍCONO -->
            <div class="flex justify-center mb-2" id="icono-pases">
                <img
                    src="/imagenes/pase.png"
                    alt="Pase de entrada"
                    class="w-14 h-14 md:w-16 md:h-16 object-contain icono-dorado"
                />
            </div>

            <!-- TÍTULO -->
            <div id="titulo-pases">
                <h2
                    class="font-great-vibes text-4xl md:text-5xl text-[#a27735] leading-tight"
                >
                    {titulo}
                </h2>

                <!-- LÍNEA DECORATIVA -->
                <div class="flex items-center justify-center gap-3 mt-2 mb-3">
                    <div
                        class="w-12 md:w-16 h-[2px] bg-gradient-to-r from-transparent to-[#a27735]"
                    >
                    </div>
                    <div class="w-2 h-2 rounded-full bg-[#a27735]"></div>
                    <div
                        class="w-12 md:w-16 h-[2px] bg-gradient-to-l from-transparent to-[#a27735]"
                    >
                    </div>
                </div>
            </div>

            <!-- NÚMERO DE PASES -->
            <div class="mb-2" id="numero-pases">
                <p
                    class="text-[#8B0000] text-5xl md:text-6xl font-bold leading-none"
                >
                    {numeroPases}
                </p>
                <p
                    class="font-charm text-xl md:text-2xl text-[#a27735] font-bold tracking-wide mt-1"
                >
                    {etiquetaPase}
                </p>
            </div>

            <!-- ÍCONOS DE PERSONAS -->
            <div
                class="flex justify-center flex-wrap gap-2 mb-3"
                id="personas-pases"
            >
                {
                    Array.from({ length: numeroPases }).map(() => (
                        <div class="w-8 h-8 rounded-full bg-[#a27735]/10 border border-[#a27735]/40 flex items-center justify-center persona-item">
                            <svg
                                class="w-4 h-4 text-[#8B0000]"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </div>
                    ))
                }
            </div>

            <!-- MENSAJE -->
            <p
                class="font-charm text-xl md:text-2xl text-[#8B0000] leading-relaxed"
                id="mensaje-pases"
            >
                {mensaje}
            </p>
        </div>
    </div>
</section>

<style>
    /* Filtro que convierte imágenes PNG negras al dorado #a27735 */
    .icono-dorado {
        filter: brightness(0) saturate(100%) invert(56%) sepia(12%)
            saturate(1486%) hue-rotate(359deg) brightness(92%) contrast(87%);
        transition:
            filter 0.3s ease,
            transform 0.3s ease;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initPases = () => {
        const card = document.getElementById("card-pases");
        if (!card) return;

        // Evita triggers duplicados al reinicializar
        ScrollTrigger.getAll().forEach((st) => {
            if (st.trigger === card) st.kill();
        });

        // Estado inicial desde JS: si el JS falla, la sección se ve igual
        gsap.set("#separador-pases", { opacity: 0, scale: 0.9 });
        gsap.set(card, { opacity: 0, y: 30 });
        gsap.set("#icono-pases", { opacity: 0, scale: 0.7 });
        gsap.set("#titulo-pases", { opacity: 0, y: 15 });
        gsap.set("#numero-pases", { opacity: 0, scale: 0.6 });
        gsap.set(".persona-item", { opacity: 0, scale: 0 });
        gsap.set("#mensaje-pases", { opacity: 0, y: 10 });

        ScrollTrigger.create({
            trigger: card,
            start: "top 90%",
            once: true,
            onEnter: () => {
                gsap
                    .timeline()
                    .to("#separador-pases", {
                        opacity: 1,
                        scale: 1,
                        duration: 0.7,
                        ease: "back.out(1.5)",
                    })
                    .to(
                        card,
                        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
                        "-=0.4",
                    )
                    .to(
                        "#icono-pases",
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.6,
                            ease: "back.out(1.8)",
                        },
                        "-=0.4",
                    )
                    .to(
                        "#titulo-pases",
                        { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
                        "-=0.3",
                    )
                    .to(
                        "#numero-pases",
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.7,
                            ease: "back.out(1.7)",
                        },
                        "-=0.2",
                    )
                    .to(
                        ".persona-item",
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.4,
                            ease: "back.out(1.7)",
                            stagger: 0.08,
                        },
                        "-=0.3",
                    )
                    .to(
                        "#mensaje-pases",
                        { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
                        "-=0.2",
                    );
            },
        });

        ScrollTrigger.refresh();
    };

    document.addEventListener("DOMContentLoaded", initPases);
    document.addEventListener("astro:page-load", initPases);
</script>
